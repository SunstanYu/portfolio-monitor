# Cloudflare Tunnel：portfolio.<你的域名> → 127.0.0.1:8000；配置见 deploy/cloudflared/config.yml.example
[Unit]
Description=portfolio-monitor Cloudflare Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared --no-autoupdate --config %h/.cloudflared/portfolio.yml tunnel run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
