# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交。

# MCP 访问令牌：Hermes / Claude Code 以 Authorization: Bearer <MCP_TOKEN> 访问 /mcp
# 生成：openssl rand -hex 32
MCP_TOKEN=

# IBKR Flex Web Service（Client Portal → Reports → Flex Queries）
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# OKX API v5：只读权限；部署后绑定服务器 IP 白名单
# 值里有 $ 时用单引号括起来（如 OKX_API_PASSPHRASE='a$b'），否则会被当成变量展开
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# 盈立新加坡（uSMART SG）Open API：个人中心 → 我的 API 拿渠道号和两把钥匙（一整段 base64 或 PEM 都行）
# 登录密码是 App 的登录密码，不是交易密码（交易密码不要放）；值里有 $ 时用单引号括起来
USMART_CHANNEL=
USMART_AREA_CODE=86
USMART_PHONE=
USMART_LOGIN_PASSWORD=
USMART_PRIVATE_KEY=
USMART_PUBLIC_KEY=
