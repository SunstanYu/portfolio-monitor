# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交。

# MCP 访问令牌：Hermes / Claude Code 以 Authorization: Bearer <MCP_TOKEN> 访问 /mcp
# 生成：openssl rand -hex 32
MCP_TOKEN=

# IBKR Flex Web Service（Client Portal → Reports → Flex Queries）
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# OKX API v5：只读权限 + 绑定服务器 IP 白名单
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# 盈立 Open API：审批通过后按官方文档补充字段
# USMART_...=
